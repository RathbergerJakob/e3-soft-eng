@startuml
title Class Diagram

skinparam classAttributeIconSize 0
hide empty members
hide circle

' Colors taken from the diagrams.net version
' blue   = managers / domain classes
' yellow = services
' green  = UI classes

' --- Managers / domain (blue) ---
class UAVRegistrationManager #dae8fc
class UAV #dae8fc
class RuntimeMonitoring #dae8fc
class FlightRouteManager #dae8fc
class FlightManager #dae8fc
class FlightZoneManager #dae8fc

' --- Services (yellow) ---
class RegistrationManagementService #fff2cc
class RouteManagementService #fff2cc
class AreaMappingService #fff2cc
class FlightManagementService #fff2cc {
  + victimFoundAlert()
}

' --- UI (green) ---
class UIUAVControl #d5e8d4
class UIMaps #d5e8d4
class "UIReal-TimeFlightView" as UIRealTimeFlightView #d5e8d4
class UIUAVVideoFeed #d5e8d4 {
  + confirmsVictim()
  + raiseVictimFoundAlert()
}

' --- Associations (open arrowhead = navigable association) ---
FlightManagementService "1" --> "0..*" UAV
FlightManagementService "1" -right-> "0..*" UIUAVVideoFeed
@enduml

