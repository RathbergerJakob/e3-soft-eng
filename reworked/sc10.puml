@startuml
title SC10 – Lease Airspace for Planned Flight Path

participant UAV
participant "FlightZoneManager\n(ATC)" as FlightZoneManager

[-> UAV : triggerLease()
activate UAV

UAV -> UAV : 1: calculateRequiredAirspace()

UAV -> FlightZoneManager : 2: leaseAirspace(airspace)
activate FlightZoneManager
FlightZoneManager -> FlightZoneManager : 3: checkAvailability(airspace)
FlightZoneManager -> FlightZoneManager : 4: reserveAirspace(airspace)
FlightZoneManager -> FlightZoneManager : 5: releasePreviousReservations(uavId)
FlightZoneManager --> UAV : 6: leaseGranted
deactivate FlightZoneManager
deactivate UAV
@enduml
