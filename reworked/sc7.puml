@startuml
title SC7 – Fly to Destination

participant DroneResponse
participant "leg : FlightLeg" as FlightLeg
participant TerrainMap
participant UAV
participant FlightZoneManager

DroneResponse -> DroneResponse : 1: decomposePathIntoLegs()

loop 5: for each flight leg
  DroneResponse -> FlightLeg ** : 2: create(startingAltitude, targetWaypoint)
  DroneResponse -> DroneResponse : 3: checkProhibitedAirspace(leg, startingAltitude)
  DroneResponse -> TerrainMap : 4: checkTerrainAltitude(leg, minimumTerrainSeparation)
end

loop 11: until isFinalDestReached()
  UAV -> UAV : 6: checkBatteryPower()
  ref over UAV, FlightZoneManager : 7: SC10 Lease Airspace\n(current flight leg)
  UAV -> UAV : 8: ascendOrDescend(targetAltitude)
  UAV -> UAV : 9: flyToWaypoint(destinationWaypoint)
  UAV -> DroneResponse : 10: reportArrival(waypoint)
end

UAV -> UAV : 12: assumeAssignedTask()
@enduml
